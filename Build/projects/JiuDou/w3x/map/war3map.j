function Trig____________________001Actions takes nothing returns nothing
    // 关闭 Blizzard 默认的中立商店购买触发器；它会强制 RemoveItemFromStock，
    // 导致装备箱即使配置 stockRegen 也会在购买后永久消失。
    if bj_stockItemPurchased != null then
        call DisableTrigger(bj_stockItemPurchased)
    endif
endfunction
//===========================================================================
function InitTrig____________________001 takes nothing returns nothing
    set gg_trg____________________001=CreateTrigger()
    call TriggerAddAction(gg_trg____________________001, function Trig____________________001Actions)
endfunction
//===========================================================================
